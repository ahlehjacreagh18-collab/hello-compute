<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Scrapbook Journal</title>
<style>
body { margin:0; background:#d2b48c; font-family:'Comic Sans MS', cursive; user-select:none; overflow-x:hidden;}
.toolbar { background:#5a4634; color:white; padding:10px; display:flex; justify-content:space-between; align-items:center;}
.toolbar input, .toolbar select, .toolbar button { margin-right:10px;}
.page { width:100%; height:90vh; background:#c9a66b; border:2px solid #5a4634; margin:0 auto; position:relative; overflow:hidden;}
.sticker { position:absolute; cursor:grab; font-size:40px; padding:5px 10px; background:white; border:2px dashed #333; border-radius:8px;}
.controls { text-align:center; margin:10px;}
</style>
</head>
<body>

<div class="toolbar">
<input type="text" id="textInput" placeholder="Type here...">
<select id="packSelect">
<option value="denim">Denim Bubble</option>
<option value="wood">Wooden</option>
<option value="neon">Retro Neon</option>
<option value="glitter">Glitter</option>
<option value="money">Money</option
